# Профиль: облачный OpenAI. Приведён как доказательство провайдеро-независимости
# слоя LLM — код не меняется, меняется только этот файл.
# ВНИМАНИЕ: включение выводит данные за пределы локального контура.
# Кейс запрещает передачу ПДн в незащищённые сервисы, поэтому PII_ENABLED
# в этом профиле обязателен, а OFFLINE_ENFORCE снимается осознанно.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-заменить
LLM_MODEL=gpt-4o-mini
LLM_MODEL_FAST=gpt-4o-mini
LLM_NUM_CTX=128000
ALLOWED_HOSTS=localhost,127.0.0.1,api.openai.com
OFFLINE_ENFORCE=false
PII_ENABLED=true
# OpenAI не знает значение "none" — параметр не отправляем вовсе.
LLM_REASONING_EFFORT=
