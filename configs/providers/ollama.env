# Профиль: локальная Ollama. Основной режим проекта — полностью офлайн.
# Применение: скопировать содержимое в .env (или слить с ним).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=avito-reviewer
LLM_MODEL_FAST=avito-reviewer-fast
LLM_NUM_CTX=32768
ALLOWED_HOSTS=localhost,127.0.0.1
OFFLINE_ENFORCE=true
LLM_REASONING_EFFORT=none
