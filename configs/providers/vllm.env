# Профиль: собственный vLLM в контуре заказчика — путь на прод.
# Тот же OpenAI-совместимый протокол, данные не покидают периметр.
LLM_BASE_URL=http://vllm.internal:8000/v1
LLM_API_KEY=not-needed
LLM_MODEL=Qwen/Qwen3.5-9B-Instruct
LLM_MODEL_FAST=Qwen/Qwen3.5-4B-Instruct
LLM_NUM_CTX=32768
ALLOWED_HOSTS=localhost,127.0.0.1,vllm.internal
OFFLINE_ENFORCE=true
LLM_REASONING_EFFORT=none
