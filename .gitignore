# Данные в репозиторий не попадают: там работы студентов, база и .env.
# В метаданных примеров работ лежат реальные ФИО — выгружать их нельзя.
# Примеры восстанавливаются scripts/fetch_examples.ps1.
data/

# Отчёт docs/results/bench_report.json нужен странице «Качество».

# секреты
.env

# python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# фронтенд: node_modules не хранится.
# ВНИМАНИЕ: web/dist намеренно НЕ игнорируется — он коммитится,
# чтобы на демонстрации не требовались ни Node, ни шаг сборки.
web/node_modules/
web/.vite/
*.tsbuildinfo

# служебное
.scratch/
.DS_Store
Thumbs.db
.idea/
.vscode/

# Материалы защиты и инструкции остаются только локально.
/CLAUDE.md
/PROJECT.md
/docs/*
!/docs/results/
/docs/results/*
!/docs/results/bench_report.json

# Локальные инструменты подготовки PDF и скриншотов.
/scripts/build_docs_pdf.py
/scripts/build_story_pdf.py
/web/scripts/
