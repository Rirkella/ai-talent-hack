# ─────────────────────────────────────────────────────────────────────────────
#  Avito AI Reviewer — конфигурация
#  Скопируйте в .env:  Copy-Item .env.example .env
#
#  Смена LLM-провайдера выполняется правкой ЭТОГО файла и не требует правок кода:
#  весь код ходит через OpenAI SDK в OpenAI-совместимый эндпоинт.
#  Готовые профили лежат в configs/providers/.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────────────────────
# Базовый URL OpenAI-совместимого API. Для Ollama обязателен суффикс /v1.
LLM_BASE_URL=http://localhost:11434/v1
# Ollama ключ не проверяет, но SDK требует непустую строку.
LLM_API_KEY=ollama
# Производная модель из scripts/Modelfile.reviewer.
# Базовую qwen3.5:9b здесь указывать НЕЛЬЗЯ: у неё num_ctx=4096 и хвост работы
# молча теряется, а /v1 не принимает options для переопределения.
LLM_MODEL=avito-reviewer
# Быстрый профиль для черновых прогонов и бенчмарка.
LLM_MODEL_FAST=avito-reviewer-fast
LLM_TEMPERATURE=0
LLM_SEED=42
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=2
# Потолок длины ответа — предохранитель от разгона генерации.
LLM_MAX_TOKENS=3072
# Управление рассуждениями. Для qwen3.5 через Ollama обязательно "none":
# при включённых рассуждениях весь вывод уходит в поле thinking, content
# остаётся пустым и запрос не завершается. Пустая строка — не отправлять
# параметр (для провайдеров, не знающих значение "none").
LLM_REASONING_EFFORT=none
# Ожидаемое окно контекста. Smoke-тест сверяет это число с фактическим
# значением из /api/show и падает при расхождении.
LLM_NUM_CTX=32768

# ── Офлайн-контур ────────────────────────────────────────────────────────────
# Хосты, куда приложению разрешено ходить. Всё остальное блокируется
# и пишется в аудит. Пустой список = запрещено всё.
ALLOWED_HOSTS=localhost,127.0.0.1
# Жёсткий офлайн: попытка выйти за пределы ALLOWED_HOSTS роняет вызов,
# а не просто пишется в лог.
OFFLINE_ENFORCE=true

# ── ПДн ──────────────────────────────────────────────────────────────────────
# Псевдонимизация до вызова модели. Выключать только для отладки.
PII_ENABLED=true
# NER-модель natasha поверх регулярок. Без неё работают только регулярки.
PII_USE_NER=true

# ── Приложение ───────────────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
DB_URL=sqlite+aiosqlite:///./data/app.db
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
# Число параллельных воркеров очереди ревью. Больше 1 на одной GPU
# смысла не имеет: Ollama всё равно сериализует запросы.
REVIEW_WORKERS=1
LOG_LEVEL=INFO

# ── Вход ─────────────────────────────────────────────────────────────
# Общий пароль демонстрационных учётных записей.
DEMO_PASSWORD=avito2026
# Показывать подсказку с логинами на экране входа. Для реального
# внедрения — false.
DEMO_SHOW_CREDENTIALS=true
# Роли для самостоятельной регистрации. В реальном внедрении — student.
OPEN_REGISTRATION_ROLES=coordinator,reviewer,student
